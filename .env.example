# TeleFlow Platform - variables de entorno (copiar a .env)

# Autenticación del gateway
TELEFLOW_API_KEY=dev-key-change-me
# Permisos de la key de bootstrap. `*` = todos. Las keys por integración se crean con
# POST /keys (requiere keys:admin) y viven hasheadas en la tabla `api_keys`.
# Scopes: flows:read flows:deploy instances:read instances:trigger instances:signal
#         instances:retry entities:read entities:write compose:read compose:write keys:admin
TELEFLOW_API_KEY_SCOPES=*
# Cache de la resolución de keys: también es la ventana máxima que sobrevive una revocada
API_KEY_CACHE_TTL=30

# Infraestructura de datos
POSTGRES_PASSWORD=teleflow
RABBITMQ_PASSWORD=teleflow
DATABASE_URL=postgresql+asyncpg://teleflow:teleflow@localhost:5432/teleflow
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://teleflow:teleflow@localhost:5672/

# Capa IA (ADR-003: proveedor configurable por instancia)
# LLM_PROVIDER: anthropic | openai | ollama | stub
# `stub` genera esqueletos para editar a mano: permite probar el ciclo compose → review →
# deploy sin credenciales. Para borradores reales, poné el proveedor Y su LLM_API_KEY:
# un proveedor real sin credencial hace que composer-service NO arranque (a propósito —
# antes caía al stub en silencio y el borrador parecía generado por el modelo).
LLM_PROVIDER=stub
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
# Techo de tokens de la respuesta. Si el modelo corta la generación, el composer lo dice
# en vez de guardar un .tflow truncado.
LLM_MAX_TOKENS=4096
# Reintentos ante fallos transitorios del proveedor (5xx, 408, 429, red), con backoff y
# full jitter. Lo permanente (4xx, credencial mala) falla en el primer intento.
LLM_RETRY_ATTEMPTS=3
LLM_RETRY_BASE_DELAY=1.0
LLM_RETRY_MAX_DELAY=20.0

# Executor
WORKER_CONCURRENCY=10
TIMER_SCAN_INTERVAL=60
# Cada cuánto se recalculan los gauges de negocio (backlog de human_tasks, procesos vivos)
BUSINESS_METRICS_INTERVAL=30
# Bus de eventos: intentos antes de mandar el evento a la DLQ (teleflow.rules.v1.dlq)
EVENT_MAX_ATTEMPTS=3
EVENT_RETRY_BASE_DELAY=1.0
# Reintentos de steps (cuántos lo dice el DSL; acá los tiempos del backoff con jitter)
STEP_RETRY_BASE_DELAY=1.0
STEP_RETRY_MAX_DELAY=30.0

# Gateway
RATE_LIMIT_RPM=120
