{
  "title": "TeleFlow · Overview",
  "uid": "teleflow-overview",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Requests por servicio (rate 5m)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (service) (rate(teleflow_http_requests_total[5m]))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Latencia p95 por servicio",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (service, le) (rate(teleflow_http_request_seconds_bucket[5m])))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Tasa de error HTTP (4xx/5xx)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum by (service) (rate(teleflow_http_requests_total{status=~\"4..|5..\"}[5m]))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Procesos completados vs fallidos",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum by (flow_name, status) (increase(teleflow_instances_total[1h]))",
          "legendFormat": "{{flow_name}} · {{status}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Steps ejecutados por resultado",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum by (step_name, result) (rate(teleflow_steps_total[5m]))",
          "legendFormat": "{{step_name}} · {{result}}"
        }
      ]
    }
  ]
}
