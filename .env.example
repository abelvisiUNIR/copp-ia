# TeleFlow Platform - variables de entorno (copiar a .env)

# Autenticación del gateway
TELEFLOW_API_KEY=dev-key-change-me

# Infraestructura de datos
POSTGRES_PASSWORD=teleflow
RABBITMQ_PASSWORD=teleflow
DATABASE_URL=postgresql+asyncpg://teleflow:teleflow@localhost:5432/teleflow
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://teleflow:teleflow@localhost:5672/

# Capa IA (ADR-003: proveedor configurable por instancia)
# LLM_PROVIDER: anthropic | openai | ollama | stub
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# Executor
WORKER_CONCURRENCY=10
TIMER_SCAN_INTERVAL=60
# Bus de eventos: intentos antes de mandar el evento a la DLQ (teleflow.rules.v1.dlq)
EVENT_MAX_ATTEMPTS=3
EVENT_RETRY_BASE_DELAY=1.0
# Reintentos de steps (cuántos lo dice el DSL; acá los tiempos del backoff con jitter)
STEP_RETRY_BASE_DELAY=1.0
STEP_RETRY_MAX_DELAY=30.0

# Gateway
RATE_LIMIT_RPM=120
